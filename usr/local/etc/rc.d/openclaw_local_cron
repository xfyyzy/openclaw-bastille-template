#!/bin/sh
#
# PROVIDE: openclaw_local_cron
# REQUIRE: LOGIN
# BEFORE: openclaw_gateway
# KEYWORD: shutdown
#

. /etc/rc.subr

name="openclaw_local_cron"
rcvar="${name}_enable"

load_rc_config "${name}"

: "${openclaw_local_cron_enable:=NO}"
: "${openclaw_local_cron_file:=/usr/local/etc/openclaw/crontab.local}"

start_cmd="${name}_start"
stop_cmd=":"
extra_commands="apply"
apply_cmd="${name}_apply"

openclaw_local_cron_start()
{
	echo "${name}: start action is disabled; use 'service ${name} apply'." >&2
	return 64
}

openclaw_local_cron_restore()
{
	if [ ! -f "${openclaw_local_cron_file}" ]; then
		echo "${name}: ${openclaw_local_cron_file} missing optional crontab file; skipping."
		return 0
	fi

	echo "${name}: restoring root crontab from ${openclaw_local_cron_file}"
	/usr/bin/crontab "${openclaw_local_cron_file}"
	rc=$?
	if [ "${rc}" -ne 0 ]; then
		echo "${name}: failed to restore crontab from ${openclaw_local_cron_file} (exit ${rc})" >&2
		return "${rc}"
	fi

	return 0
}

openclaw_local_cron_apply()
{
	openclaw_local_cron_restore
}

run_rc_command "$1"
